# ──────────────────────────────────────────────
# Sky Q Voice Control — environment variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────

# Comma-separated list of  name:ip_address  pairs.
# The name must match what you say to Google Home ("in the living room").
# Underscores and hyphens are treated as spaces.
SKY_DEVICES=living_room:192.168.1.100,bedroom:192.168.1.101

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Cloudflare Tunnel (optional) ──
# Create a tunnel at https://dash.cloudflare.com → Zero Trust → Tunnels
# then paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# ── GitHub repository (used by docker-compose image tag) ──
GITHUB_REPOSITORY=skochy/quickstart-js
